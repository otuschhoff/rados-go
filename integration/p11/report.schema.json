{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passed": { "const": "passed" },
    "true": { "const": true },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "mon_caps", "mgr_caps", "osd_caps"],
      "properties": {
        "entity": { "type": "string", "minLength": 1 },
        "mon_caps": { "type": "string" },
        "mgr_caps": { "type": "string" },
        "osd_caps": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "command", "started_at", "finished_at", "source", "server", "native_runtime", "cluster", "scenarios", "probe", "native"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "passed" },
    "command": { "const": "make integration-p11" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "identity", "artifacts"],
      "properties": {
        "repository": { "const": "https://github.com/otuschhoff/rados-go.git" },
        "identity": { "const": "content-addressed-artifacts" },
        "artifacts": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/sha256" } }
      }
    },
    "server": {
      "type": "object", "additionalProperties": false, "required": ["repository", "source_anchor_commit", "version", "image", "platform", "binaries"],
      "properties": {
        "repository": { "const": "https://github.com/ceph/ceph.git" },
        "source_anchor_commit": { "const": "7f793731f1b39eb4f465e960113d2363c311b964" },
        "version": { "const": "ceph version 20.2.4 (7f793731f1b39eb4f465e960113d2363c311b964) tentacle (stable)" },
        "image": { "enum": ["quay.io/ceph/ceph@sha256:09ee90f6f3e0c7b9954f71d214ee05e9bbaaaea3716b1dd619603283b829f8b8", "quay.io/ceph/ceph@sha256:6e6bc7b28fa1b334108a3646af5533dfb50db508efdf5b358eb7dd0dd37a48aa"] },
        "platform": { "enum": ["linux/amd64", "linux/arm64"] },
        "binaries": {
          "type": "object", "additionalProperties": false, "required": ["mon_sha256", "mgr_sha256", "osd_sha256"],
          "properties": { "mon_sha256": { "$ref": "#/$defs/sha256" }, "mgr_sha256": { "$ref": "#/$defs/sha256" }, "osd_sha256": { "$ref": "#/$defs/sha256" } }
        }
      }
    },
    "native_runtime": {
      "type": "object", "additionalProperties": false, "required": ["soname", "path", "package", "sha256"],
      "properties": {
        "soname": { "const": "librados.so.2" }, "path": { "type": "string", "pattern": "^/.+" },
        "package": { "enum": ["librados2-20.2.4-0.el9.x86_64", "librados2-20.2.4-0.el9.aarch64"] }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cluster": {
      "type": "object", "additionalProperties": false,
      "required": ["fsid", "network", "osds", "objectstore", "osd_device_bytes", "pool", "manager_daemons", "admin_client", "io_client"],
      "properties": {
        "fsid": { "const": "21111111-2222-4333-8444-111111111111" },
        "network": { "const": "172.30.111.0/24" },
        "osds": { "const": 1 },
        "objectstore": { "const": "bluestore" },
        "osd_device_bytes": { "const": 4294967296 },
        "manager_daemons": { "const": 2 },
        "pool": {
          "type": "object", "additionalProperties": false, "required": ["name", "size", "min_size", "pg_num"],
          "properties": { "name": { "const": "p11-data" }, "size": { "const": 1 }, "min_size": { "const": 1 }, "pg_num": { "const": 8 } }
        },
        "admin_client": { "$ref": "#/$defs/client" },
        "io_client": { "$ref": "#/$defs/client" }
      }
    },
    "scenarios": {
      "type": "object", "additionalProperties": false,
      "required": ["administration", "native_conformance", "manager_failover", "manager_loss_io", "least_privilege", "destructive_resource_validation"],
      "properties": {
        "administration": { "$ref": "#/$defs/passed" }, "native_conformance": { "$ref": "#/$defs/passed" },
        "manager_failover": { "$ref": "#/$defs/passed" }, "manager_loss_io": { "$ref": "#/$defs/passed" },
        "least_privilege": { "$ref": "#/$defs/passed" }, "destructive_resource_validation": { "$ref": "#/$defs/passed" }
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false, "required": ["admin", "recovery", "least_privilege"],
      "properties": {
        "admin": {
          "type": "object", "additionalProperties": false,
          "required": ["cluster_stats", "pool_stats", "monitor_command", "manager_command", "osd_command", "pg_command", "pool_create_delete", "application_metadata", "session_addresses", "blocklist", "inconsistent_pgs", "inconsistent_objects", "command_error_output_preserved"],
          "properties": {
            "cluster_stats": { "$ref": "#/$defs/true" }, "pool_stats": { "$ref": "#/$defs/true" }, "monitor_command": { "$ref": "#/$defs/true" },
            "manager_command": { "$ref": "#/$defs/true" }, "osd_command": { "$ref": "#/$defs/true" }, "pg_command": { "$ref": "#/$defs/true" },
            "pool_create_delete": { "$ref": "#/$defs/true" }, "application_metadata": { "$ref": "#/$defs/true" },
            "session_addresses": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^v[12]:.+/[0-9]+$" } },
            "blocklist": { "$ref": "#/$defs/true" }, "inconsistent_pgs": { "$ref": "#/$defs/true" }, "inconsistent_objects": { "$ref": "#/$defs/true" },
            "command_error_output_preserved": { "$ref": "#/$defs/true" }
          }
        },
        "recovery": {
          "type": "object", "additionalProperties": false, "required": ["manager_before_failover", "manager_after_failover", "io_after_manager_loss"],
          "properties": { "manager_before_failover": { "$ref": "#/$defs/true" }, "manager_after_failover": { "$ref": "#/$defs/true" }, "io_after_manager_loss": { "$ref": "#/$defs/true" } }
        },
        "least_privilege": {
          "type": "object", "additionalProperties": false, "required": ["write_read_without_manager"],
          "properties": { "write_read_without_manager": { "$ref": "#/$defs/true" } }
        }
      }
    },
    "native": {
      "type": "object", "additionalProperties": false,
      "required": ["cluster_stats", "pool_stats", "monitor_command", "manager_command", "osd_command", "pg_command", "pool_create_delete", "application_metadata", "session_addresses", "blocklist", "inconsistent_pgs"],
      "properties": {
        "cluster_stats": { "$ref": "#/$defs/true" }, "pool_stats": { "$ref": "#/$defs/true" }, "monitor_command": { "$ref": "#/$defs/true" },
        "manager_command": { "$ref": "#/$defs/true" }, "osd_command": { "$ref": "#/$defs/true" }, "pg_command": { "$ref": "#/$defs/true" },
        "pool_create_delete": { "$ref": "#/$defs/true" }, "application_metadata": { "$ref": "#/$defs/true" }, "session_addresses": { "$ref": "#/$defs/true" },
        "blocklist": { "$ref": "#/$defs/true" }, "inconsistent_pgs": { "$ref": "#/$defs/true" }
      }
    }
  }
}
